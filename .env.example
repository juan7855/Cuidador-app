# Postgres connection string (Supabase).
# Local/migraciones (drizzle-kit): usa la conexión directa, puerto 5432.
# Runtime en Vercel (serverless): usa la conexión con pooler (Transaction pooler), puerto 6543,
# y agrega ?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/app_db
